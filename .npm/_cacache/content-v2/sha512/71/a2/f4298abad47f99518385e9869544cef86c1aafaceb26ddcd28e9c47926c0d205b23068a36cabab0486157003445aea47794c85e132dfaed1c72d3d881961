-matrix/udse.svg\n","maintainers":[{"name":"twada","email":"takuto.wada@gmail.com"}],"time":{"modified":"2022-06-28T04:58:41.590Z","created":"2016-05-02T17:09:42.066Z","0.1.0":"2016-05-02T17:09:42.066Z","1.0.0":"2016-05-03T16:17:29.706Z","1.1.0":"2016-05-05T15:58:56.675Z","1.2.0":"2016-05-06T08:07:54.659Z","1.2.1":"2016-05-06T09:09:11.234Z","1.2.2":"2016-07-11T10:21:22.155Z"},"homepage":"https://github.com/twada/universal-deep-strict-equal","keywords":["assert","assertion","builtin","core","deep","deep-equal","deep-strict-equal","eq","equal","equality","same","strict","test","testing"],"repository":{"type":"git","url":"git://github.com/twada/universal-deep-strict-equal.git"},"author":{"name":"Takuto Wada","email":"takuto.wada@gmail.com","url":"https://github.com/twada"},"bugs":{"url":"https://github.com/twada/universal-deep-strict-equal/issues"},"license":"MIT","readmeFilename":"README.md","contributors":[{"name":"azu","url":"https://github.com/azu"}]}