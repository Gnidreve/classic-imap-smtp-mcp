# classic-imap-smtp-mcp — Single-Account Env-Var Setup
# Kopiere zu .env (oder setze direkt im MCP-Client-Config unter "env").
# Für Multi-Account: stattdessen config.toml verwenden (siehe config.example.toml).

# --- Pflicht ---
CLASSIC_IMAP_SMTP_USER=you@example.com
CLASSIC_IMAP_SMTP_PASS=your-app-password

# --- Host/Port: bei Auto-Detect-Providern weglassen ---
# Auto-Detect: gmail.com, outlook.com/hotmail.com/live.com, icloud.com/me.com/mac.com,
# yahoo.com, fastmail.com, posteo.de, mailbox.org, gmx.*, web.de, proton.me (Bridge)
CLASSIC_IMAP_SMTP_IMAP_HOST=imap.example.com
CLASSIC_IMAP_SMTP_IMAP_PORT=993
CLASSIC_IMAP_SMTP_SMTP_HOST=smtp.example.com
CLASSIC_IMAP_SMTP_SMTP_PORT=465

# --- TLS-Modus: true (implicit) | starttls | false (plain, nicht empfohlen) ---
CLASSIC_IMAP_SMTP_IMAP_TLS=true
CLASSIC_IMAP_SMTP_SMTP_TLS=true

# --- Optional ---
CLASSIC_IMAP_SMTP_FROM_NAME=Your Name
CLASSIC_IMAP_SMTP_VERIFY_TLS=true
# CLASSIC_IMAP_SMTP_LOG_LEVEL=info        # trace|debug|info|warn|error

# HINWEIS: Feature-Flags (--safe, --readonly, --no-imap, --no-smtp, --allow-tools, --deny-tools)
# werden NICHT hier gesetzt, sondern ausschließlich als CLI-Args beim Start.
# Env-Vars sind nur für Verbindung/Logging.
