{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": "on",
      "suspicious": { "noConsole": "error" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "overrides": [
    {
      "files": { "include": ["pnpm-lock.yaml"] },
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ]
}
